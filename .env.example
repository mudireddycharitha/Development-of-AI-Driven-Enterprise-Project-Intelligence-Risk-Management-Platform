# Copy this file to .env in the repository root. Never commit the local .env file.
# Local-only data directory (defaults to ./data)
# APP_DATA_DIR=C:\path\to\ProjectIntelligencePlatform_Milestone1\data

# Document-processing limits
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=25
MAX_EXTRACTED_CHARS=10000000
MAX_CHUNKS_PER_DOCUMENT=20000

# Approximate word-token chunking configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# The same model is used for document chunks and search queries.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local Vite development server origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Assistant chat only. Rule-based Milestone 2 agents remain available without a provider key.
# Put a real secret in the repository-root .env file or the backend process environment.
# Supported values: openai, azure, ollama. Providers are never selected automatically.
AI_PROVIDER=openai
# Maximum time for one LLM request; the assistant UI allows 100 seconds.
LLM_REQUEST_TIMEOUT_SECONDS=90
# Uncomment and replace with your key in the local repository-root .env file.
# OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI alternative:
# AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-api-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional local inference with Ollama; change AI_PROVIDER above to ollama only if installed.
# No model is downloaded automatically. OLLAMA_MODEL must exactly match an installed model.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
