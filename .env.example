# Local-only data directory (defaults to ./data)
# APP_DATA_DIR=C:\path\to\ProjectIntelligencePlatform_Milestone1\data

# Document-processing limits
MAX_FILE_SIZE_MB=50
MAX_BATCH_FILES=25
MAX_EXTRACTED_CHARS=10000000
MAX_CHUNKS_PER_DOCUMENT=20000

# Approximate word-token chunking configuration
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# The same model is used for document chunks and search queries.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local Vite development server origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI integration: rule_based (default), openai, or azure
AI_PROVIDER=rule_based
# OPENAI_API_KEY=your-key
# OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_ENDPOINT=https://example-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
